@startuml jewerly_c4_model_tracing_solution
!include <C4/C4_Container>

title Jewerly Store System - tracing solution

AddElementTag("tracing", $bgColor="#f8cecc", $borderColor="#b85450", $fontColor="#000000")
AddRelTag("tracing", $lineColor="#b85450", $textColor="#b85450")

Person(customer, "Customer", "Creates orders and uploads or designs 3d models")
Person(seller, "Seller", "Operates with orders and confirms manufacturing for users")
Person(operator, "Operator", "Takes orders in work and manufactures jewelry")
Person(apiUser, "API user", "External partner using public API")

System_Boundary(jewerlyStore, "Jewerly Store System") {
  Container(internetShop, "Internet Shop", "Vue, TypeScript, Three.js", "User can make an order, upload a 3d model, and work in 3d editor")
  Container(shopApi, "Shop API", "Spring Boot", "Provides shop items, receives 3d files, and stores customer order data")
  ContainerDb(shopDb, "Shop DB", "PostgreSQL", "Holds customer and order data")

  Container(crm, "CRM", "Vue, TypeScript", "Seller-facing order management UI")
  Container(crmApi, "CRM API", "Spring Boot", "Manages CRM order operations")

  Container(mes, "MES", "React, TypeScript", "Operator UI for assigning orders and viewing order lists")
  Container(mesApi, "MES API", "C#", "Assigns orders to operators, shows order lists, and calculates order price")
  ContainerDb(mesDb, "MES DB", "PostgreSQL", "Holds orders, operator assignments, and MES-side statuses")

  ContainerQueue(messagesQueue, "Messages Queue", "RabbitMQ", "Sends messages about new orders and status changes between containers")
  ContainerDb(filesStorage, "3d files storage", "S3-based storage", "Stores 3d files so that price can be calculated")

  Container(traceContext, "Trace context", "HTTP and RabbitMQ headers", "trace_id, span_id, order_id", $tags="tracing")
  Container(traceSdk, "OpenTelemetry SDK", "Java/.NET instrumentation", "Creates spans in Shop API, CRM API and MES API", $tags="tracing")
  Container(traceCollector, "OpenTelemetry Collector", "OpenTelemetry", "Receives, filters and exports spans", $tags="tracing")
  Container(traceStorage, "Trace Storage / UI", "Jaeger or Grafana Tempo", "Stores traces and provides search UI", $tags="tracing")
}

Rel(customer, internetShop, "Uses")
Rel(internetShop, shopApi, "Calls")
Rel(shopApi, shopDb, "Reads and writes")
Rel(shopApi, filesStorage, "Uploads 3d files")

Rel(seller, crm, "Uses")
Rel(crm, crmApi, "Calls")
Rel(crmApi, shopDb, "Reads and writes")
Rel(crmApi, messagesQueue, "Publishes and consumes order events")
Rel(filesStorage, crmApi, "Provides 3d files metadata")

Rel(operator, mes, "Uses")
Rel(mes, mesApi, "Calls")
Rel(mesApi, mesDb, "Reads and writes")
Rel(mesApi, filesStorage, "Reads 3d files")
Rel(mesApi, messagesQueue, "Publishes and consumes order events")

Rel(apiUser, mesApi, "Calls public API")

Rel(shopApi, traceContext, "Propagates context in outgoing calls", $tags="tracing")
Rel(crmApi, traceContext, "Propagates context in HTTP and RabbitMQ messages", $tags="tracing")
Rel(mesApi, traceContext, "Propagates context in HTTP and RabbitMQ messages", $tags="tracing")
Rel(shopApi, traceCollector, "Exports spans", $tags="tracing")
Rel(crmApi, traceCollector, "Exports spans", $tags="tracing")
Rel(mesApi, traceCollector, "Exports spans", $tags="tracing")
Rel(traceSdk, traceCollector, "Sends instrumented spans", $tags="tracing")
Rel(traceCollector, traceStorage, "Stores traces", $tags="tracing")

Lay_R(customer, internetShop)
Lay_R(internetShop, shopApi)
Lay_R(shopApi, shopDb)
Lay_D(shopApi, filesStorage)

Lay_R(seller, crm)
Lay_R(crm, crmApi)
Lay_R(crmApi, messagesQueue)

Lay_R(operator, mes)
Lay_U(mes, mesApi)
Lay_R(mesApi, mesDb)
Lay_R(apiUser, mesApi)

Lay_R(traceCollector, traceStorage)

SHOW_LEGEND()
@enduml
